{
  "expo": {
    "name": "SealedVault",
    "slug": "sealedvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sealedvault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050507",
    "ios": {
      "bundleIdentifier": "app.sealedvault",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.sealedvault",
      "adaptiveIcon": {
        "backgroundColor": "#050507",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050507",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#8f6bff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SealedVault potřebuje přístup k fotkám, abys mohl přidat fotky svých produktů.",
          "cameraPermission": "SealedVault potřebuje fotoaparát, abys mohl vyfotit své produkty.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6080459b-ff73-43cd-ab68-293ab6e2929c"
      }
    },
    "owner": "adaminooo"
  }
}
